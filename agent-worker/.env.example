# Copy to agent-worker/.env.local (git-ignored) and fill in.
#
# ONE RULE FOR THE WHOLE FILE: never leave a second, empty copy of a key below
# a filled-in one. python-dotenv takes the LAST occurrence, so a trailing blank
# silently wins and the worker reports the value as unset while it sits right
# there a few lines above. This file ships many keys blank on purpose, and
# `nano` appends at the end -- so edit the existing line rather than adding one.
# It has already cost a real lead: SLACK_WEBHOOK_URL was set, duplicated, and
# read as empty.
#
# See ../DEPLOYMENT.md for the full VPS setup, step by step.

# --- Supabase (same project as dashboard/.env.local) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Schema setup: `python -m worker.migrate` ---------------------------------
# The Postgres connection string (Project Settings -> Database -> Connection
# string -> URI). Nothing on the call path uses it: the two values above go
# through PostgREST, which cannot create tables, so creating the schema needs a
# real Postgres connection.
#
# Two ways this silently breaks:
#
# 1. Percent-encode special characters in the password. Supabase shows you the
#    raw one, and a literal "@" makes the URI parser split there and treat the
#    rest of your password as the hostname -- the error is then a DNS failure
#    on a host you've never seen.
#        @ -> %40    $ -> %24    + -> %2B    / -> %2F    : -> %3A
#    Simplest cure: reset the database password to letters and digits only.
#
# 2. Use port 5432 (direct or session pooler), NOT 6543 (transaction pooler) --
#    the migrator takes a session-scoped pg_advisory_lock, which transaction
#    pooling drops between statements.
SUPABASE_DB_URL=

# Added to allowed_users so somebody can sign in to the dashboard on a fresh
# database. Migrations 0003/0004 seed Kodexo's own addresses, so without this a
# new deployment comes up with a dashboard nobody there can log into. Only read
# by the migrator; the worker ignores it.
ADMIN_EMAIL=

# --- LiveKit (same server as infra/.env) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match roomConfig.agents[].agentName in infra/sip/dispatch-rule.example.json
LIVEKIT_AGENT_NAME=kodexo-inbound-agent
# CPU load above which this worker refuses calls. Leave BLANK (the default) to
# never refuse: LiveKit's load shedding is designed to hand a call to a less busy
# worker in a pool, and with a single worker there is no one to hand it to -- the
# call is simply dropped, with no error anywhere and nothing but a "marking as
# unavailable" line in this worker's log to show why the phone rang out. The
# framework's own default of 0.7 is crossed routinely by any box that also runs a
# dashboard or Docker. Set a number below 1.0 only once you run a pool.
WORKER_LOAD_THRESHOLD=

# --- STT / TTS (Deepgram covers both -- Nova-3 + Aura) ---
DEEPGRAM_API_KEY=

# --- LLM: default provider (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM: DeepSeek, only needed if any agent has llm_provider='deepseek' ---
# Switchable per-agent from the dashboard at any time -- see VOICE_STACK_DECISION.md.
#
# These three are really "any OpenAI-compatible chat endpoint", not DeepSeek
# specifically. That matters for latency: DeepSeek's origin API measured ~1.6s
# for a one-sentence reply, which is slow for live voice, and the cause is its
# infrastructure and network path rather than the model. DeepSeek is open-weight,
# so the same model can be served from a US datacenter instead -- one hop from
# the VPS rather than a trip to the origin.
#
# To re-host, set all three together (the model ID is namespaced per provider):
#   DEEPSEEK_BASE_URL=https://api.deepinfra.com/v1/openai
#   DEEPSEEK_API_KEY=<your DeepInfra key>
#   DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Together AI works the same way with its own base URL and model naming.
#
# The worker sends DeepSeek's proprietary `thinking: disabled` parameter only
# when BASE_URL is the origin API -- other hosts 400 on unknown parameters.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Gemini. One key, two completely different engines. ---
# Needed if any agent has llm_provider='gemini' OR llm_provider='gemini_live'.
GEMINI_API_KEY=

# llm_provider='gemini' -- Gemini Flash as an ordinary text LLM inside the
# Deepgram pipeline (Flux STT -> Gemini -> Aura TTS). This is the default and
# the fastest option measured: 451ms best / 499ms median time-to-first-token
# for a one-sentence phone reply, against 535/648 for DeepSeek's origin API.
# See supabase/migrations/0019 for the full comparison.
#
# Keep this on a 2.x model unless you also change the worker: reasoning is
# disabled via `thinking_budget=0`, and the 3.x models reject that field in
# favour of `thinking_level`. A model that reasons before answering adds dead
# air to every single turn.
GEMINI_LLM_MODEL=gemini-2.5-flash

# llm_provider='gemini_live' -- speech-to-speech, replaces STT+LLM+TTS
# entirely for that agent. Cheaper, but it decides turn-taking server-side, so
# none of the Deepgram/Flux settings below reach it -- see
# VOICE_STACK_DECISION.md for the full list of what it gives up.
# MUST be a native-audio model for inbound calls. The 3.x live models
# (gemini-3.1-flash-live-preview and friends) can't accept a client-initiated
# first turn, so the agent never greets -- and if GEMINI_PROACTIVE_AUDIO is set
# as well, they reject the session outright and the call is silent end to end.
# From the phone both failures look the same: nobody ever speaks.
#
# Live models this key can use, verified against the API:
#   gemini-2.5-flash-native-audio-latest            <- default, greets fine
#   gemini-2.5-flash-native-audio-preview-12-2025
#   gemini-2.5-flash-native-audio-preview-09-2025
#   gemini-3.1-flash-live-preview                   <- cannot greet; avoid
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
# Gemini's "proactive audio": the model decides for itself whether speech was
# addressed to it and stays silent otherwise -- a second line of defence on a
# noisy phone line, on top of the activity-detection tuning the worker always
# applies (see entrypoint._gemini_activity_detection). Native-audio models
# only; leave empty on 3.x, which rejects the session outright.
GEMINI_PROACTIVE_AUDIO=

# The DEEPGRAM_* turn-taking settings below do NOT apply to gemini_live agents.
# That engine is speech-to-speech: no Deepgram STT or TTS is created for it at
# all, and its turn-taking is decided server-side by Gemini.

# --- Notifications (optional -- skipped if unset) ---
#
# NOTE: set this to a value or delete the line -- do not leave a second, empty
# SLACK_WEBHOOK_URL= line below your real one. python-dotenv takes the LAST
# occurrence in the file, so a trailing blank silently wins and the worker logs
# "SLACK_WEBHOOK_URL not set" while the URL sits right there above it.
SLACK_WEBHOOK_URL=

# Where the dashboard is served, e.g. https://voiceagents.kodexolabs.co. Used
# only to put an "Open call record" button on the Slack lead alert, linking to
# that call's page. Leave blank and the button is omitted; everything else in
# the message is unaffected.
DASHBOARD_BASE_URL=

# --- Call recording (LiveKit Egress -> Cloudinary) ---
# OFF by default, and the default is a decision rather than laziness: these are
# inbound PSTN calls, and recording them carries consent obligations that depend
# on the caller's jurisdiction and yours. Switching this on is also taking
# responsibility for saying so in the agent's greeting where that's required.
#
# Needs the `egress` container from infra/docker-compose.yml running. Note that
# an audio-only recording still runs a headless Chrome per call, which is real
# CPU on a single-box deployment -- if reply latency matters, run egress
# elsewhere before turning this on.
#
# The worker refuses to start a call with this set but the Cloudinary
# credentials below incomplete, rather than recording into a void.
CALL_RECORDING_ENABLED=
# The two ends of one bind mount. RECORDING_EGRESS_DIR is the path *inside* the
# egress container (matches the left side of `./recordings:/out` in
# docker-compose.yml); RECORDING_OUTPUT_DIR is where this worker sees that same
# directory. If they don't refer to the same place, every egress will succeed
# and the worker will report finding no file.
RECORDING_OUTPUT_DIR=/opt/kodexo/recordings
RECORDING_EGRESS_DIR=/out

# --- Call recording storage (Cloudinary) ---
# Required whenever CALL_RECORDING_ENABLED is set. Uploaded as an
# `authenticated` asset, so the stored URL needs signing before it plays --
# recordings of customer calls shouldn't be fetchable by anyone who has the link.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kodexo-calls

# --- Turn taking / latency ------------------------------------------------
# Which Deepgram STT the worker runs. "flux" (default) uses Deepgram Flux,
# which reports end-of-turn from the speech itself instead of the session
# waiting on a fixed silence timer -- the largest latency win available on a
# phone call, where PSTN transit and jitter buffers already cost ~500ms that
# no setting can shorten. nova-3 stays wired as an automatic fallback if Flux
# is unavailable on the account or its socket drops mid-call.
# Set to "nova" to skip Flux entirely (one-variable rollback).
DEEPGRAM_STT_ENGINE=flux
DEEPGRAM_FLUX_MODEL=flux-general-en
# Confidence at which Flux calls the turn finished. Higher waits longer and
# interrupts less.
DEEPGRAM_FLUX_EOT_THRESHOLD=0.7
# Lower bar for a provisional end-of-turn, letting the LLM start early. Must
# be below DEEPGRAM_FLUX_EOT_THRESHOLD.
DEEPGRAM_FLUX_EAGER_EOT_THRESHOLD=0.5
# Ceiling on waiting for the threshold once speech stops.
DEEPGRAM_FLUX_EOT_TIMEOUT_MS=600

# --- Post-call analysis -----------------------------------------------------
# Which LLM writes the call summary, the caller's queries and the priority
# (see analysis.py). "deepseek" (default) or "gemini".
#
# This is the one job DeepSeek is clearly right for. It was rejected as the
# conversation engine because ~1.6s per reply is unusable mid-call, but this
# runs in the shutdown callback after the caller has hung up -- nothing is
# waiting on it, and it costs roughly a tenth of Gemini Flash for the same
# work (about $0.0007 a call).
#
# Needs DEEPSEEK_API_KEY (or GEMINI_API_KEY) set. If the key is missing the
# analysis is skipped and the call is still logged, with those fields NULL.
ANALYSIS_LLM=deepseek

# Per-call cost, split by platform and written to call_logs (see pricing.py).
# Defaults are the published pay-as-you-go rates verified 2026-08-13; override
# any of them if your account is on different terms. Rates change -- these are
# a starting point, not a contract.
#
# Telephony is the odd one out: Twilio bills the account directly and this
# worker has no Twilio credentials, so its cost is duration x this rate rather
# than a real reading. Everything else is priced from metered usage.
# PRICE_STT_FLUX_PER_MIN=0.0065
# PRICE_STT_NOVA_PER_MIN=0.0048
# PRICE_TTS_AURA2_PER_1K=0.030
# PRICE_TTS_AURA1_PER_1K=0.015
# PRICE_LLM_GEMINI_FLASH_IN_PER_1M=0.30
# PRICE_LLM_GEMINI_FLASH_OUT_PER_1M=2.50
# PRICE_TELEPHONY_PER_MIN=0.0085

# --- Debugging ------------------------------------------------------------
# Logs the caller's audio level once a second, to settle "the agent can't hear
# me" with a number instead of inference (normal speech peaks near -20 dBFS;
# under about -60 is silence on the wire).
#
# Off by default because it isn't free: it opens a second subscription to the
# caller's track, does per-frame work on the job's event loop 100x a second and
# writes a line per second for the whole call. On a shared box that competes
# with pushing TTS audio out on time. Switch it on for the call you're
# debugging, then switch it back off.
CALLER_AUDIO_METER=
